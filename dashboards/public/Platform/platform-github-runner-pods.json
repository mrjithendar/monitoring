    {
      "type": "stat",
      "title": "Fullest runner container",
      "description": "The runner container closest to its memory limit. At 100% the kernel kills a process in it (exit 137). dind has no limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{job=\"kubernetes-cadvisor\", namespace=\"runners\", container=\"runner\", node=~\"$node\"} / (container_spec_memory_limit_bytes{job=\"kubernetes-cadvisor\", namespace=\"runners\", container=\"runner\", node=~\"$node\"} > 0))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
