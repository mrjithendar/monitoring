    {
      "type": "stat",
      "title": "Runner pods",
      "description": "Pods in namespace runners with a running runner container (one per job).",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "count(count by (pod) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\", namespace=\"runners\", container=\"runner\", node=~\"$node\"})) or vector(0)",
          "legendFormat": "",
