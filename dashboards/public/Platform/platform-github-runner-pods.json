    {
      "type": "stat",
      "title": "OOM kills: worker out of memory",
      "description": "In the time range: processes the kernel killed because a node ran out of memory (SystemOOM), in any pod, not only runners. Runner pods that use far more than their requests cause these.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "round(sum(increase(container_oom_events_total{job=\"kubernetes-cadvisor\", id=\"/\", node=~\"$node\"}[$__range]))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
