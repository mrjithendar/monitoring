    {
      "type": "timeseries",
      "title": "Memory pressure on each worker",
      "description": "Share of time tasks waited for memory (Linux PSI). some: at least one task waited; full: every task stalled. Sustained full pressure comes before SystemOOM.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "rate(container_pressure_memory_waiting_seconds_total{job=\"kubernetes-cadvisor\", id=\"/\", node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} some"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "rate(container_pressure_memory_stalled_seconds_total{job=\"kubernetes-cadvisor\", id=\"/\", node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} full"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
