  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "MOKS processes started",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "step": "1m",
        "expr": "count(time() - process_start_time_seconds{job=\"moks\"} < 90) > 0",
        "titleFormat": "MOKS processes started (rollout or restart)",
        "textFormat": "{{value}} process(es)",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace (logs)",
        "type": "constant",
        "query": "moks-sre",
        "hide": 2
      },
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "definition": "label_values(up{job=\"moks\"}, component)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"moks\"}, component)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": ""
      }
    ]
  },
