{
  "uid": "moks-ml",
  "title": "MOKS · ML anomaly detection",
  "description": "MOKS's own models in shadow mode: scoring, flags, drift, champion health and incident correlation.",
  "tags": [
    "moks",
    "ml"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "timepicker": {},
  "weekStart": "",
  "links": [
    {
      "title": "Live infrastructure",
      "type": "link",
      "url": "/grafana/d/live-infrastructure",
      "icon": "dashboard",
      "tooltip": "All public dashboards",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tags": []
    },
    {
      "title": "MOKS dashboards",
      "type": "dashboards",
      "tags": [
        "moks"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "jithendar.com",
      "type": "link",
      "url": "https://jithendar.com/",
      "icon": "external link",
      "tooltip": "Articles about how this is built",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": true,
      "tags": []
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "MOKS processes started",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "step": "1m",
        "expr": "count(time() - process_start_time_seconds{job=\"moks\"} < 90) > 0",
        "titleFormat": "MOKS processes started (rollout or restart)",
        "textFormat": "{{value}} process(es)",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace (logs)",
        "type": "constant",
        "query": "moks-sre",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Shadow mode.** MOKS's models score and correlate, people judge, nothing is acted on. Empty panels mean anomaly detection is disabled (Settings, Anomaly detection) or no champion is active. After a deploy with a new feature schema, champions report `stale_schema` until retrained (docs/ML.md)."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Scoring",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Observations by status",
      "description": "Observations recorded per bar.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (capability, status) (increase(moks_ml_observations_total{job=\"moks\"}[$__interval]))",
          "legendFormat": "{{capability}} · {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Flagged windows",
      "description": "Scored windows flagged unusual, by algorithm, level and model role (champion or challenger).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (algorithm, level, role) (increase(moks_ml_flags_total{job=\"moks\"}[$__interval]))",
          "legendFormat": "{{algorithm}} {{role}} · {{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Inference p95 per window",
      "description": "Time to score one cohort window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, capability, algorithm) (rate(moks_ml_inference_seconds_bucket{job=\"moks\"}[$__interval])))",
          "legendFormat": "{{capability}} {{algorithm}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Fallbacks to deterministic",
      "description": "ML paths that fell back to rules, per bar.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (capability, reason) (increase(moks_ml_fallbacks_total{job=\"moks\"}[$__interval]))",
          "legendFormat": "{{capability}} · {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "bargauge",
      "title": "Missing features",
      "description": "Scored windows in the time range where a feature was absent or under half coverage. mk4 lacks kube-state-metrics, so restarts and node pressure are often missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (feature) (increase(moks_ml_missing_features_total{job=\"moks\"}[$__range]))) > 0",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 10,
        "maxVizHeight": 300,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      }
    },
    {
      "type": "row",
      "title": "Model health",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Input drift (PSI), top 10",
      "description": "Population stability index of each feature against the champion's training data, for the last scored window. Above 0.25 is a large shift.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (cohort, feature) (moks_ml_feature_drift_psi{job=\"moks\"}))",
          "legendFormat": "{{cohort}} {{feature}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "stat",
      "title": "Champions to review",
      "description": "Champions whose health check recommends review (drift, flag rate or judged precision).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (algorithm, reason) (moks_ml_model_degraded{job=\"moks\"}) == 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 21
      }
    },
    {
      "type": "bargauge",
      "title": "Why review",
      "description": "The champions flagged for review, and why.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (algorithm, reason) (moks_ml_model_degraded{job=\"moks\"}) == 1",
          "legendFormat": "{{algorithm}} · {{reason}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 10,
        "maxVizHeight": 300,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      }
    },
    {
      "type": "row",
      "title": "Correlation",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "timeseries",
      "title": "Correlation groups",
      "description": "Groups created, updated and closed, per bar.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event) (increase(moks_ml_correlation_groups_total{job=\"moks\"}[$__interval]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "timeseries",
      "title": "Grouping time p95",
      "description": "Time to group one environment's anomalies, context included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(moks_ml_correlation_seconds_bucket{job=\"moks\"}[$__interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      }
    },
    {
      "type": "timeseries",
      "title": "Context that could not be read",
      "description": "Correlation context (mesh calls, nodes, rollouts) that a source could not give, per bar.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source) (increase(moks_ml_context_gaps_total{job=\"moks\"}[$__interval]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
