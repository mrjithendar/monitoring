          "expr": "histogram_quantile(0.5, sum by (le, backend) (rate(moks_retrieval_latency_seconds_bucket{job=\"moks\"}[$__interval])))",
          "legendFormat": "p50 {{backend}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(moks_retrieval_latency_seconds_bucket{job=\"moks\"}[$__interval])))",
          "legendFormat": "p95 {{backend}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
