{
  "uid": "moks-knowledge",
  "title": "MOKS · Knowledge and retrieval",
  "description": "Knowledge search in PostgreSQL + pgvector: modes, latency, what was missing, embeddings and reranking.",
  "tags": [
    "moks",
    "knowledge",
    "rag"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "timepicker": {},
  "weekStart": "",
  "links": [
    {
      "title": "Live infrastructure",
      "type": "link",
      "url": "/grafana/d/live-infrastructure",
      "icon": "dashboard",
      "tooltip": "All public dashboards",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tags": []
    },
    {
      "title": "MOKS dashboards",
      "type": "dashboards",
      "tags": [
        "moks"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "jithendar.com",
      "type": "link",
      "url": "https://jithendar.com/",
      "icon": "external link",
      "tooltip": "Articles about how this is built",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": true,
      "tags": []
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "MOKS processes started",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "step": "1m",
        "expr": "count(time() - process_start_time_seconds{job=\"moks\"} < 90) > 0",
        "titleFormat": "MOKS processes started (rollout or restart)",
        "textFormat": "{{value}} process(es)",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "regex": "",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace (logs)",
        "type": "constant",
        "query": "moks-sre",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Searches",
      "description": "Knowledge searches in the time range, by any mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(moks_retrieval_searches_total{job=\"moks\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Answered with less",
      "description": "Searches answered with less than was asked for (no vectors, no reranker, keyword only), over all searches. MoksRetrievalFallingBack fires on any.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(moks_retrieval_fallbacks_total{job=\"moks\"}[$__range])) / clamp_min(sum (increase(moks_retrieval_searches_total{job=\"moks\"}[$__range])), 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Search p95",
      "description": "95th percentile retrieval latency in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(moks_retrieval_latency_seconds_bucket{job=\"moks\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Reranked",
      "description": "Share of rerank attempts in the time range whose order was applied (others timed out, failed or were skipped).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(moks_rerank_calls_total{job=\"moks\", outcome=\"applied\"}[$__range])) / clamp_min(sum (increase(moks_rerank_calls_total{job=\"moks\"}[$__range])), 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Embedding cache reuse",
      "description": "Share of texts needing a vector that the embedding cache answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (increase(moks_rag_embedding_inputs_total{job=\"moks\", outcome=\"reused\"}[$__range])) / clamp_min(sum (increase(moks_rag_embedding_inputs_total{job=\"moks\"}[$__range])), 1)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
