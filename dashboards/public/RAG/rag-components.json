          "expr": "sum by (response_code, response_flags) (rate(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__rate_interval]))",
          "legendFormat": "{{response_code}} {{response_flags}}",
