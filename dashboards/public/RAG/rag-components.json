          "expr": "max(container_memory_working_set_bytes{job=\"kubernetes-cadvisor\", namespace=\"rag\", pod=~\"${component}-.*\", container!=\"\", container!=\"POD\", container!=\"istio-proxy\"}) / max(container_spec_memory_limit_bytes{job=\"kubernetes-cadvisor\", namespace=\"rag\", pod=~\"${component}-.*\", container!=\"\", container!=\"POD\", container!=\"istio-proxy\"} > 0)",
          "legendFormat": "__auto",
