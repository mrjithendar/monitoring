    {
      "type": "timeseries",
      "title": "Requests/s in, by caller",
      "description": "Requests this component answered, per caller, counted by its own sidecar. Qdrant: rag-api's readiness probe alone is one request every 10 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum by (source_workload_namespace, source_workload) (rate(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload_namespace}}/{{source_workload}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0
