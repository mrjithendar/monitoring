    {
      "type": "stat",
      "title": "Requests in",
      "description": "Requests to this component in the time range: what its sidecar answered plus what callers could not deliver, first requests of a new caller or pod included.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum((increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range])) or (increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]))) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Server errors",
      "description": "Share of those requests that got a 5xx or never reached the pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "(sum((increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code=~\"5..\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code=~\"5..\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code=~\"5..\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code=~\"5..\"}[$__range])) or (increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]))) or vector(0)) / sum((increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\"}[$__range])) or (increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) + (min_over_time(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range]) unless istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"} offset $__range) or increase(istio_requests_total{job=\"envoy-stats\", reporter=\"source\", destination_service_namespace=\"rag\", response_flags=~\".*(UH|UF|UO|NR).*\", destination_service_name=\"${component}\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No requests"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "p95 in",
      "description": "95th percentile of this component's response time in the time range, WebSocket upgrades left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) ((increase(istio_request_duration_milliseconds_bucket{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code!=\"101\"}[$__range]) + (min_over_time(istio_request_duration_milliseconds_bucket{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code!=\"101\"}[$__range]) unless istio_request_duration_milliseconds_bucket{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code!=\"101\"} offset $__range) or increase(istio_request_duration_milliseconds_bucket{job=\"envoy-stats\", reporter=\"destination\", destination_service_namespace=\"rag\", destination_service_name=\"${component}\", response_code!=\"101\"}[$__range]))))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No requests"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Memory of limit",
      "description": "Working set of the main container over its memory limit; the kernel OOM-kills it at 100%.",
